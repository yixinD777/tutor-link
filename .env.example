# ====== 环境变量模板 ======
# 复制此文件为 .env，填入真实值，.env 不会被提交

ANTHROPIC_API_KEY=your_api_key_here
AI_BASE_URL=https://api.xiaomimimo.com/anthropic
AI_MODEL=mimo-v2.5-pro

# MySQL
MYSQL_PASSWORD=

# Redis
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_at_least_256_bits

# WeChat
WX_APPID=
WX_SECRET=
WX_MCH_ID=
WX_PAY_API_KEY=
WX_PAY_CERT_PATH=
WX_PAY_NOTIFY_URL=

# OSS
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
